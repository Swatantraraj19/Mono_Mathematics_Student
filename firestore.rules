rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Student / User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow initial registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Allow student to update their personal/academic info, but prevent role/status hijacking
      allow update: if isOwner(userId) 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'instituteId']))
        || (isAuthenticated() && request.auth.token.role == 'admin');
      allow delete: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    // 2. App Settings (Access Mode: open vs approval)
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    // 3. Academic Structure (Classes & Streams)
    match /classes/{classId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    match /streams/{streamId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    // 4. Subjects & Chapters
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    match /chapters/{chapterId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    // 5. Recorded Videos / Lectures
    match /videos/{videoId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    // 6. Live Classes
    match /live_classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }
  }
}
